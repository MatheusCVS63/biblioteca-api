# Exemplo de variaveis de ambiente.
# Copie este arquivo para ".env" e ajuste os valores conforme necessario.
# NUNCA coloque chaves ou senhas reais no repositorio.

# String de conexao do banco de dados.
# Padrao: SQLite em arquivo local.
DB_URL=sqlite:///./biblioteca.db

# Chave de API usada para acessar os endpoints protegidos (POST/PATCH/DELETE).
# Em producao, use um valor longo e aleatorio.
API_KEY=biblioteca-chave-local
